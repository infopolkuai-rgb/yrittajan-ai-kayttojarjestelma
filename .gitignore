# Salaisuudet. Näitä ei koskaan viedä gitiin.
.env
.env.local
.secrets
*.secret
*-sa.json
*service-account*.json
client_secret*.json

# Omat haastattelut ja tarkistusraportit ovat yksityisiä.
haastattelut/*
!haastattelut/.gitkeep
tarkistukset/*
!tarkistukset/.gitkeep

# HUOM. Nama tiedostot toimitetaan tyhjina pohjina, joten ne ovat mukana.
# Kun /aloita on tayttanyt ne, niissa on asiakkaiden nimia, hintoja ja
# kohteita. Jos viet oman kansiosi gitiin tai jaat sen eteenpain, poista
# risuaidat naiden edesta:
#haastattelu.md
#tausta/aani.md
#tausta/yritys.md

# Roskaa
.DS_Store
Thumbs.db
*.log
*.bak
__pycache__/
node_modules/
.claude/settings.local.json
